    GiverKey: Quest_4
    GiverName: "\uB4F1\uBD88\uC9C0\uAE30 \uC138\uB77C"
    Chapter: "\uC11C\uB9C9 \xB7 \uAEBC\uC838 \uAC00\uB294 \uBE5B"
    Title: "\uC791\uC740 \uBD88\uC528"
    Objective: RuneShop
    RegionNumber: 0
    StageNumber: 0
    ObjectiveText: "\uB8EC \uC0C1\uC810\uC758 \uB8E8\uC544\uC640 \uB300\uD654\uD558\uAE30"
    OfferDialogue: "\uB9C8\uC744 \uC131\uC18C\uC758 \uBE5B\uC774 \uC57D\uD574\uC9C0\uACE0
      \uC788\uC5B4\uC694. \uAE30\uC0AC, \uAD81\uC218, \uB9C8\uBC95\uC0AC\u2026 \uC11C\uB85C
      \uB2E4\uB978 \uC138 \uB9C8\uC74C\uC774 \uD568\uAED8\uB77C\uBA74 \uAE38\uC744
      \uCC3E\uC744 \uC218 \uC788\uACA0\uC8E0. \uBA3C\uC800 \uAD11\uC7A5 \uB0A8\uB3D9\uCABD\uC758
      \uB8E8\uC544\uB97C \uB9CC\uB098 \uC8FC\uC138\uC694."
    ActiveDialogue: "\uB0A8\uB3D9\uCABD \uB8EC \uC0C1\uC810\uC758 \uB8E8\uC544\uB97C
      \uB9CC\uB098 \uC8FC\uC138\uC694. NPC\uB97C \uB204\uB974\uBA74 \uBC14\uB85C
      \uC0C1\uC810\uC774 \uC5F4\uB824\uC694."
    CompleteDialogue: "\uB8E8\uC544\uB3C4 \uC61B \uC131\uC18C\uC758 \uC9D5\uD6C4\uB97C
      \uB290\uAF08\uAD70\uC694. \uC774\uC81C \uC138 \uBD84\uC744 \uC9C0\uD0AC \uC900\uBE44\uB97C
      \uD574\uC694."
    RewardGold: 400
    RewardStones: 3
  - Key: Ward
    Order: 1
    GiverKey: Quest_4
    GiverName: "\uB4F1\uBD88\uC9C0\uAE30 \uC138\uB77C"
    Chapter: "\uC11C\uB9C9 \xB7 \uC138 \uC601\uC6C5\uC758 \uC57D\uC18D"
    Title: "\uD568\uAED8 \uB3CC\uC544\uC624\uAE30"
    Objective: EquipWard
    RegionNumber: 0
    StageNumber: 0
    ObjectiveText: "\uC218\uD638\uC758 \uB8EC \uC7A5\uCC29"
    OfferDialogue: "\uAC15\uD55C \uD798\uBCF4\uB2E4 \uBA3C\uC800 \uD544\uC694\uD55C
      \uAC74 \uD568\uAED8 \uB3CC\uC544\uC624\uACA0\uB2E4\uB294 \uC57D\uC18D\uC774\uC5D0\uC694.
      \uB8EC \uC0C1\uC810\uC758 \uAC15\uD654\xB7\uC7A5\uCC29\uC5D0\uC11C \uC218\uD638\uC758
      \uB8EC\uC744 \uC7A5\uCC29\uD574 \uC8FC\uC138\uC694. \uC774\uBBF8 \uAC00\uC9C4
      \uB8EC\uB3C4 \uC4F8 \uC218 \uC788\uC5B4\uC694."
    ActiveDialogue: "\uC218\uD638\uC758 \uB8EC\uC744 \uC7A5\uCC29\uD558\uC138\uC694.
      \uB8EC \uC0C1\uC810\uC774\uB098 \uCE90\uB9AD\uD130 \uD0ED\uC758 \uB8EC\uC11D
      \uAD00\uB9AC\uC5D0\uC11C \uC900\uBE44\uD560 \uC218 \uC788\uC5B4\uC694."
    CompleteDialogue: "\uC88B\uC544\uC694. \uBD81\uB3D9\uCABD \uC815\uCC30\uAFBC
      \uB9B0\uC774 \uD3D0\uAD11\uC5D0\uC11C \uC0AC\uB77C\uC9C4 \uBE5B\uC744 \uBCF4\uC558\uB300\uC694.
      \uB9B0\uC5D0\uAC8C \uAC00 \uBCF4\uC138\uC694."
    RewardGold: 500
    RewardStones: 3
  - Key: Chapter1_1
    Order: 2
    GiverKey: Quest_1
    GiverName: "\uC815\uCC30\uAFBC \uB9B0"
    Chapter: "1\uC7A5 \xB7 \uB545\uC18D\uC758 \uAE30\uC5B5"
    Title: "\uB2EB\uD78C \uAE38"
    Objective: Victory
    RegionNumber: 1
    StageNumber: 1
    ObjectiveText: "\uAD11\uC0B0 \uC785\uAD6C (1\uC9C0\uC5ED 1\uC2A4\uD14C\uC774\uC9C0)
      \uC2B9\uB9AC"
    OfferDialogue: "\uBC24\uB9C8\uB2E4 \uAD11\uC0B0 \uC785\uAD6C\uC5D0\uC11C \uAD34\uBB3C\uB4E4\uC774
      \uB098\uC640\uC694. \uAE38\uC744 \uC5F4\uBA74 \uC548\uCABD\uC5D0\uC11C \uBB34\uC2A8
      \uC77C\uC774 \uC77C\uC5B4\uB098\uB294\uC9C0 \uC54C \uC218 \uC788\uC5B4\uC694."
    ActiveDialogue: "\uAD11\uC0B0 \uC785\uAD6C (1\uC9C0\uC5ED 1\uC2A4\uD14C\uC774\uC9C0)
      \uC2B9\uB9AC"
    CompleteDialogue: "\uC785\uAD6C\uAC00 \uC870\uC6A9\uD574\uC84C\uAD70\uC694. \uBC84\uB824\uC9C4
      \uAC31\uB3C4\uC5D0\uC11C \uD478\uB978 \uBE5B\uC774 \uD754\uB4E4\uB9AC\uB294
      \uAC78 \uBD24\uC5B4\uC694."
    RewardGold: 750
    RewardStones: 2
  - Key: Chapter1_2
    Order: 3
    GiverKey: Quest_1
    GiverName: "\uC815\uCC30\uAFBC \uB9B0"
    Chapter: "1\uC7A5 \xB7 \uB545\uC18D\uC758 \uAE30\uC5B5"
    Title: "\uD76C\uBBF8\uD55C \uB9E5\uB3D9"
    Objective: Victory
    RegionNumber: 1
    StageNumber: 2
    ObjectiveText: "\uBC84\uB824\uC9C4 \uAC31\uB3C4 (1\uC9C0\uC5ED 2\uC2A4\uD14C\uC774\uC9C0)
      \uC2B9\uB9AC"
    OfferDialogue: "\uAC31\uB3C4\uC5D0 \uB0A8\uC740 \uBE5B\uC740 \uB9C8\uC744 \uC131\uC18C\uC640
      \uAC19\uC740 \uBC15\uC790\uB85C \uB5A8\uB824\uC694. \uAD34\uBB3C\uB4E4\uC744
      \uBB3C\uB9AC\uCE58\uACE0 \uADF8 \uD754\uC801\uC744 \uB530\uB77C\uAC00 \uC8FC\uC138\uC694."
    ActiveDialogue: "\uBC84\uB824\uC9C4 \uAC31\uB3C4 (1\uC9C0\uC5ED 2\uC2A4\uD14C\uC774\uC9C0)
      \uC2B9\uB9AC"
    CompleteDialogue: "\uBE5B\uC774 \uC9C0\uD558\uC218\uB85C\uB97C \uB530\uB77C \uD750\uB978\uB300\uC694.
      \uB204\uAD70\uAC00 \uC131\uC18C\uC758 \uD798\uC744 \uB04C\uC5B4\uAC00\uACE0
      \uC788\uB294 \uAC83 \uAC19\uC544\uC694."
    RewardGold: 800
    RewardStones: 2
  - Key: Chapter1_3
